---
import Layout from '../components/Layout.astro';

const services = [
  ['Plumbing', '01'], ['Electricity', '02'], ['Air conditioning', '03'],
  ['Painting', '04'], ['Carpentry', '05'], ['Appliance repair', '06'],
  ['Cleaning', '07'], ['General maintenance', '08'], ['Construction', '09'],
];
---
<Layout title="FIXGAD — Trouvez le bon Hrayfi" description="FIXGAD connects customers in Morocco with trusted independent home-service professionals.">
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Marketplace locale du Maroc</p>
        <h1>Trouvez le bon <em>Hrayfi.</em><br/>Faites le job.</h1>
        <p class="hero-lead">Des réparations du quotidien aux travaux essentiels, FIXGAD vous met en relation avec des professionnels indépendants près de chez vous.</p>
        <div class="hero-actions">
          <a class="button" href="/services/">Trouver un professionnel <span>→</span></a>
          <a class="button button-outline" href="/for-hrayfis/">Devenir Hrayfi</a>
        </div>
        <div class="hero-trust"><span class="status-dot"></span><span><strong>Agadir</strong><small>En lancement · Bientôt partout au Maroc</small></span></div>
      </div>

      <div class="hero-product" aria-label="Illustration interactive du produit FIXGAD">
        <div class="app-window">
          <div class="app-bar">
            <span class="app-logo"><img src="/assets/fixgad-emblem.png" alt="" /> FIXGAD</span>
            <div class="app-profile">AB</div>
          </div>
          <div class="app-layout">
            <aside><b>Accueil</b><span>Mes missions</span><span>Messages</span><span>Profil</span></aside>
            <div class="app-main">
              <div class="app-greeting"><span><small>Bonjour, Ahmed</small><strong>Besoin d'un coup de main ?</strong></span><span class="app-location">Agadir · 80000</span></div>
              <label class="app-search"><span>⌕</span><input aria-label="Search a service" value="" placeholder="Que faut-il réparer ?" /><b>Rechercher</b></label>
              <div class="app-map">
                <svg viewBox="0 0 560 250" role="img" aria-label="Carte illustrative des services à Agadir">
                  <path d="M0 42 C90 74 130 15 205 51 S330 95 415 38 S500 20 560 58 M-10 180 C95 128 150 210 245 158 S410 118 575 172 M88 -10 C120 72 105 140 158 260 M300 -10 C270 78 340 135 300 260 M454 -10 C420 82 475 150 510 260" fill="none" stroke="#D8DDCF" stroke-width="16"/>
                  <path d="M0 42 C90 74 130 15 205 51 S330 95 415 38 S500 20 560 58 M-10 180 C95 128 150 210 245 158 S410 118 575 172" fill="none" stroke="#FFF" stroke-width="5"/>
                  <g class="app-pin"><circle cx="280" cy="128" r="20"/><circle cx="280" cy="128" r="6"/></g>
                  <g class="app-pin small"><circle cx="170" cy="94" r="12"/><circle cx="170" cy="94" r="4"/></g>
                  <g class="app-pin small"><circle cx="410" cy="155" r="12"/><circle cx="410" cy="94" r="4"/></g>
                </svg>
                <div class="mission-popover"><span>PL</span><div><b>Réparation robinet</b><small>3 Hrayfis disponibles</small></div><i>›</i></div>
              </div>
              <div class="app-categories"><button type="button" class="active">Tous</button><button type="button">Plomberie</button><button type="button">Électricité</button><button type="button">Peinture</button></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="proof-strip" aria-label="FIXGAD values">
    <div class="container proof-grid"><span><b>✓</b> Fiable & vérifié</span><span><b>⌖</b> Proche de vous</span><span><b>↯</b> Rapide & simple</span><span><b>◎</b> Transparent</span></div>
  </section>

  <section class="section process-section">
    <div class="container">
      <div class="section-heading"><p class="eyebrow">COMMENT ÇA MARCHE</p><h2>De “j’ai besoin d’aide” à “c’est réparé”.</h2></div>
      <div class="process-grid">
        <article><span class="process-number">01</span><div class="process-icon">＋</div><h3>Décrivez le problème</h3><p>Partagez les détails, ajoutez des photos et indiquez votre adresse.</p></article>
        <article><span class="process-number">02</span><div class="process-icon">⇄</div><h3>Recevez des offres</h3><p>Les Hrayfis disponibles près de vous répondent avec des offres claires.</p></article>
        <article><span class="process-number">03</span><div class="process-icon">✓</div><h3>Choisissez & faites-vous aider</h3><p>Comparez les profils, échangez et lancez le service en confiance.</p></article>
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="section-heading split"><div><p class="eyebrow">TOUS LES ESSENTIELS DU QUOTIDIEN</p><h2>Un métier pour chaque besoin.</h2></div><a class="text-link" href="/services/">Voir tous les services <span>→</span></a></div>
      <div class="service-grid">{services.map(([name, number]) => <a class="service-card" href="/services/"><span>{number}</span><strong>{name}</strong><i>↗</i></a>)}</div>
    </div>
  </section>

  <section class="audience-section audience-customer">
    <div class="container audience-grid">
      <div class="audience-copy"><p class="eyebrow">POUR LES CLIENTS</p><h2>Plus clair. Plus simple. Plus proche.</h2><p>Décrivez votre mission une seule fois, puis comparez les offres des professionnels indépendants de votre zone.</p><ul><li>Photos et adresse incluses</li><li>Offres faciles à comparer</li><li>Communication directe</li><li>Avis après chaque mission</li></ul><a class="button" href="/early-access/">Publier une mission</a></div>
      <div class="mission-preview">
        <div class="preview-top"><span>Ma mission</span><b>● Brouillon</b></div><h3>Fuite sous l’évier</h3><p>Agadir · Ajoutée à l'instant</p><div class="preview-photo"><span>Cuisine</span><span>+2 photos</span></div><div class="preview-offers"><div><small>OFFRES REÇUES</small><strong>3</strong></div><a href="/early-access/">Comparer les offres →</a></div>
      </div>
    </div>
  </section>

  <section class="audience-section audience-hrayfi">
    <div class="container audience-grid reverse">
      <div class="mission-preview hrayfi-preview"><div class="preview-top"><span>Profil Hrayfi</span><b>Disponible</b></div><div class="hrayfi-profile"><span>Y</span><div><strong>Youssef · Plombier</strong><small>Agadir · 4 ans d'expérience</small></div></div><div class="skill-tags"><span>Plomberie</span><span>Chauffe-eau</span><span>Installation</span></div><div class="new-mission"><small>NOUVELLE MISSION PRÈS DE VOUS</small><strong>Installation chauffe-eau</strong><p>Agadir · 2,4 km <a href="/for-hrayfis/">Voir la mission →</a></p></div></div>
      <div class="audience-copy"><p class="eyebrow">POUR LES HRAYFIS</p><h2>Vos compétences méritent plus d’opportunités.</h2><p>Trouvez des missions pertinentes, présentez vos services et développez une réputation à partir de votre travail.</p><ul><li>Découvrir les missions proches</li><li>Recevoir des demandes locales</li><li>Envoyer des offres en toute clarté</li><li>Construire votre réputation</li></ul><a class="button button-sand" href="/for-hrayfis/">Découvrir FIXGAD Hrayfi</a></div>
    </div>
  </section>

  <section class="final-cta"><div class="container"><p class="eyebrow">COMMENCEZ AVEC FIXGAD</p><h2>Votre prochain projet mérite<br/><em>le bon professionnel.</em></h2><div><a class="button" href="/early-access/">Trouver un professionnel</a><a class="button button-outline" href="/for-hrayfis/">Devenir Hrayfi</a></div></div></section>
</Layout>
