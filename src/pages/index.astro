---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const services = [
  ['Plumbing', 'PL'], ['Electricity', 'EL'], ['Air conditioning', 'AC'],
  ['Painting', 'PT'], ['Carpentry', 'CP'], ['Appliance repair', 'AR'],
  ['Cleaning', 'CL'], ['General maintenance', 'GM'], ['Construction & renovation', 'CR'],
  ['Other home services', 'OT'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>FIXGAD — The right hands for your home</title>
    <meta name="description" content="FIXGAD connects customers in Morocco with trusted independent home-service professionals." />
    <meta property="og:title" content="FIXGAD — The right hands for your home" />
    <meta property="og:description" content="Find trusted independent professionals around you." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-cover.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div id="top"></div>
    <Header />
    <main>
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">MOROCCO'S HOME-SERVICE MARKETPLACE</p>
            <h1 data-i18n="hero.headline">Your home deserves <em>the right hands.</em></h1>
            <p class="hero-intro" data-i18n="hero.support">From everyday repairs to essential home services, FIXGAD connects you with trusted independent professionals around you.</p>
            <div class="button-row">
              <a class="button" href="#early-access" data-i18n="hero.join">Find a professional</a>
              <a class="button button-quiet" href="#hrayfis" data-i18n="hero.hrayfi">Become a Hrayfi <span aria-hidden="true">↗</span></a>
            </div>
            <p class="hero-note"><span class="status-dot"></span> Starting in Agadir · Expanding across Morocco</p>
          </div>
          <div class="product-window" aria-label="Illustrative FIXGAD product interface">
            <div class="window-bar"><span class="window-brand">FIXGAD <small>MISSIONS</small></span><span class="window-user">A</span></div>
            <div class="window-body">
              <div class="window-sidebar"><span class="sidebar-active">Overview</span><span>My missions</span><span>Messages</span><span>Profile</span></div>
              <div class="window-content">
                <div class="content-top"><div><small>GOOD MORNING</small><strong>Find help around you.</strong></div><span class="location-chip">● Agadir</span></div>
                <div class="search-panel"><span class="search-icon">⌕</span><span>What do you need help with?</span><b>Search</b></div>
                <div class="map-preview">
                  <svg viewBox="0 0 520 230" role="img" aria-label="Illustrative service map around Agadir">
                    <path d="M0 42 C80 70 120 18 190 49 S315 87 390 36 S470 18 520 55 M-20 177 C80 126 145 210 235 152 S390 112 550 165 M92 -15 C122 63 108 126 158 250 M284 -20 C264 65 330 132 293 250 M430 -10 C402 78 449 133 488 250" fill="none" stroke="#d7ddce" stroke-width="14"/>
                    <path d="M0 42 C80 70 120 18 190 49 S315 87 390 36 S470 18 520 55 M-20 177 C80 126 145 210 235 152 S390 112 550 165 M92 -15 C122 63 108 126 158 250 M284 -20 C264 65 330 132 293 250 M430 -10 C402 78 449 133 488 250" fill="none" stroke="#f8f7f1" stroke-width="5"/>
                    <g class="map-marker marker-main" transform="translate(260 119)"><circle r="18"/><path d="M-5 0h10M0-5v10"/></g>
                    <g class="map-marker marker-small" transform="translate(157 94)"><circle r="10"/></g><g class="map-marker marker-small" transform="translate(386 148)"><circle r="10"/></g>
                  </svg>
                  <span class="map-caption">Illustrative map · sample locations</span>
                  <div class="floating-mission"><span class="mini-icon">PL</span><span><b>Kitchen tap repair</b><small>3 professionals nearby</small></span><i>›</i></div>
                </div>
                <div class="window-categories"><span>Plumbing</span><span>Electricity</span><span>Painting</span><span>More +</span></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="how" class="section journey-section">
        <div class="container">
          <div class="section-head"><p class="eyebrow">A CLEARER WAY TO GET THINGS DONE</p><h2 data-i18n="how.title">From “I need help” to “it’s done.”</h2><p>One simple flow for finding the right professional, without the guesswork.</p></div>
          <div class="steps">
            <article class="step"><span class="step-number">01</span><span class="step-icon">✦</span><h3>Describe your problem.</h3><p>Tell us what needs fixing, add photos and share your location.</p></article>
            <article class="step"><span class="step-number">02</span><span class="step-icon">⇄</span><h3>Receive offers nearby.</h3><p>Relevant Hrayfis discover your Mission and send clear offers.</p></article>
            <article class="step"><span class="step-number">03</span><span class="step-icon">✓</span><h3>Choose and get it done.</h3><p>Compare your options, communicate clearly and move forward.</p></article>
          </div>
        </div>
      </section>

      <section id="services" class="section services-section">
        <div class="container">
          <div class="section-head split-head"><div><p class="eyebrow">THE EVERYDAY ESSENTIALS</p><h2>Skilled help for real life.</h2></div><p>From a quick repair to a full renovation, find the right craft for the job.</p></div>
          <div class="service-grid">{services.map(([name, code]) => <a href="#early-access" class="service-card"><span class="service-icon">{code}</span><span><strong>{name}</strong><small>Find a professional <b aria-hidden="true">↗</b></small></span></a>)}</div>
        </div>
      </section>

      <section id="customers" class="experience-section customer-experience">
        <div class="container experience-grid">
          <div class="experience-copy"><p class="eyebrow">FOR CUSTOMERS</p><h2 data-i18n="customer.title">More clarity. Better decisions.</h2><p data-i18n="customer.copy">Everything you need to explain the job, compare your options and feel confident about who you invite into your home.</p><ul class="check-list"><li>Describe your problem and upload photos.</li><li>Share your location for relevant matches.</li><li>Compare professional offers side by side.</li><li>Communicate, complete and rate your experience.</li></ul><a class="button" href="#early-access" data-i18n="customer.cta">Find a professional</a></div>
          <div class="experience-visual customer-ui"><div class="ui-label">YOUR MISSION <span>Draft</span></div><h3>Kitchen sink repair</h3><p class="muted">Agadir · Added just now</p><div class="photo-strip"><span>Kitchen</span><span>+2 photos</span></div><div class="offer-summary"><div><small>OFFERS RECEIVED</small><strong>03</strong></div><span>Compare professionals<br/><b>View offers →</b></span></div></div>
        </div>
      </section>

      <section id="hrayfis" class="experience-section hrayfi-experience">
        <div class="container experience-grid">
          <div class="experience-visual hrayfi-ui"><div class="profile-top"><span class="avatar">M</span><span><b>My Hrayfi profile</b><small>Independent professional</small></span><i>•••</i></div><div class="profile-line"><span>PLUMBING</span><span>INSTALLATION</span><span>MAINTENANCE</span></div><div class="mission-request"><small>NEW MISSION NEAR YOU</small><strong>Water heater installation</strong><span>Agadir · 2.4 km away <b>View mission →</b></span></div></div>
          <div class="experience-copy"><p class="eyebrow">FOR HRAYFIS</p><h2 data-i18n="hrayfi.title">Your skills deserve more opportunities.</h2><p data-i18n="hrayfi.copy">FIXGAD gives independent tradespeople a clear way to find nearby missions, present their craft and grow a reputation on their own terms.</p><ul class="check-list"><li>Find nearby missions that match your skills.</li><li>Receive customer requests and send offers.</li><li>Build a reputation through reliable work.</li><li>Grow your independent business.</li></ul><a class="button button-light" href="#early-access" data-i18n="hrayfi.cta">Become a Hrayfi</a></div>
        </div>
      </section>

      <section class="trust-section section">
        <div class="container">
          <div class="section-head centered"><p class="eyebrow">BUILT AROUND TRUST</p><h2>Good work starts with clarity.</h2><p>We are designing the foundations for a marketplace where people can make informed choices.</p></div>
          <div class="trust-grid"><article><span>01</span><h3>Identity, made clear.</h3><p>Professional verification is part of the trust experience we intend to build.</p></article><article><span>02</span><h3>Offers without surprises.</h3><p>Clear communication and transparent offers help everyone start aligned.</p></article><article><span>03</span><h3>Reputation that compounds.</h3><p>Customer reviews are planned to help reliable professionals stand out over time.</p></article></div>
          <p class="disclaimer">FIXGAD is currently an early-stage product. These are intended platform principles, not claims that every feature is operational today.</p>
        </div>
      </section>

      <section id="about" class="about-section">
        <div class="container about-panel"><div><p class="eyebrow">BUILT FOR MOROCCO</p><h2>Local work.<br/><em>Better connected.</em></h2></div><div><p>FIXGAD is building a more accessible way for people across Morocco to find skilled help, while giving independent Hrayfis more opportunities to grow.</p><p class="about-note"><span class="status-dot"></span> Launching in Agadir, with Morocco in mind.</p></div></div>
      </section>

      <section id="early-access" class="early-access">
        <div class="container access-grid"><div class="access-copy"><p class="eyebrow">GET CLOSER TO FIXGAD</p><h2>Be part of what comes next.</h2><p>Choose your path and register your interest. This local demo does not store submissions yet.</p></div>
          <form id="early-access-form" class="access-form" novalidate><fieldset class="type-picker"><legend>I’m joining as a</legend><label><input type="radio" name="type" value="customer" checked/><span>Customer</span></label><label><input type="radio" name="type" value="hrayfi"/><span>Hrayfi</span></label></fieldset><div class="form-row"><label>Full name<input name="name" autocomplete="name" required/></label><label>Email<input type="email" name="email" autocomplete="email" required/></label></div><div class="form-row"><label>City<input name="city" autocomplete="address-level2" required/></label><label id="category-field" hidden>Professional category<select name="category"><option value="">Select a category</option>{services.map(([name]) => <option value={name}>{name}</option>)}</select></label></div><label class="consent"><input type="checkbox" name="consent" required/><span>I consent to FIXGAD contacting me about early access.</span></label><p class="form-status" id="form-status" role="status"></p><button class="button button-wide" type="submit">Register interest</button></form>
        </div>
      </section>
    </main>
    <Footer />
    <script>import '../scripts/site';</script>
  </body>
</html>
