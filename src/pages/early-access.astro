---
import Layout from '../components/Layout.astro';
---
<Layout title="Accès anticipé — FIXGAD" description="Rejoignez FIXGAD comme client ou comme Hrayfi.">
  <section class="access-page"><div class="container access-grid"><div class="access-copy"><p class="eyebrow">ACCÈS ANTICIPÉ</p><h1>Construisons la prochaine expérience locale.</h1><p>Choisissez votre parcours et indiquez-nous comment vous souhaitez utiliser FIXGAD.</p><div class="access-points"><span><b>01</b> Inscription locale</span><span><b>02</b> Accès aux prochaines étapes</span><span><b>03</b> Formulaire clairement identifié comme démonstration</span></div></div><form id="early-access-form" class="access-form" novalidate><fieldset class="type-picker"><legend>Je rejoins comme</legend><label><input type="radio" name="type" value="customer" checked/><span>Client</span></label><label><input type="radio" name="type" value="hrayfi"/><span>Hrayfi</span></label></fieldset><div class="form-row"><label>Nom complet<input name="name" autocomplete="name" required/></label><label>Email<input type="email" name="email" autocomplete="email" required/></label></div><div class="form-row"><label>Ville<input name="city" autocomplete="address-level2" required/></label><label id="category-field" hidden>Service<select name="category"><option value="">Choisir un service</option><option>Plomberie</option><option>Électricité</option><option>Climatisation</option><option>Peinture</option><option>Menuiserie</option><option>Électroménager</option><option>Nettoyage</option><option>Maintenance générale</option><option>Construction & rénovation</option></select></label></div><label class="consent"><input type="checkbox" name="consent" required/><span>J’accepte d’être contacté(e) au sujet de FIXGAD.</span></label><p class="form-status" id="form-status" role="status"></p><button class="button button-wide" type="submit">Enregistrer mon intérêt</button></form></div></section>
</Layout>
