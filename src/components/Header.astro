---
import Brand from './Brand.astro';
---
<header class="site-header">
  <div class="nav-shell">
    <Brand />
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Open navigation">
      <span></span><span></span><span></span>
    </button>
    <nav id="main-nav" class="main-nav" aria-label="Main navigation">
      <a href="#top" data-i18n="nav.home">Home</a>
      <a href="#how" data-i18n="nav.how">How it works</a>
      <a href="#customers" data-i18n="nav.customers">For customers</a>
      <a href="#hrayfis" data-i18n="nav.hrayfis">For Hrayfis</a>
      <a href="#services" data-i18n="nav.services">Services</a>
      <a href="#about" data-i18n="nav.about">About</a>
      <div class="language-switcher language-switcher-mobile" aria-label="Language">
        <button type="button" data-lang="en" class="active" aria-pressed="true">EN</button>
        <button type="button" data-lang="fr" aria-pressed="false">FR</button>
        <button type="button" data-lang="ar" aria-pressed="false">AR</button>
      </div>
    </nav>
    <div class="nav-actions">
      <div class="language-switcher" aria-label="Language">
        <button type="button" data-lang="en" class="active" aria-pressed="true">EN</button>
        <button type="button" data-lang="fr" aria-pressed="false">FR</button>
        <button type="button" data-lang="ar" aria-pressed="false">AR</button>
      </div>
      <a class="button button-small" href="#early-access" data-i18n="nav.join">Join early access</a>
    </div>
  </div>
</header>
